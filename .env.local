# Configuration pour développement LOCAL (hors Docker)
# Ce fichier est utilisé quand vous exécutez python app.py directement sur votre machine
# Pour Docker, utilisez config.env

FLASK_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-2026
JWT_SECRET_KEY=dev-jwt-secret-key-2026

# Configuration Base de Données PostgreSQL pour développement LOCAL
# Utilise localhost car host.docker.internal ne fonctionne que dans Docker
DATABASE_URL=postgresql://postgres:admin123@localhost:5433/postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=postgres

# Configuration Email SMTP
SMTP_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=contact@firdaws-mosque.ci
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
