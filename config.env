# Configuration Email SMTP
SMTP_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=contact@firdaws-mosque.ci
# IMPORTANT: Utilisez un mot de passe d'application Gmail de 16 caractères
# Généré depuis: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Configuration alternative (si Gmail ne fonctionne pas)
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587

FLASK_ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-2026
JWT_SECRET_KEY=dev-jwt-secret-key-2026

# Configuration Base de Données PostgreSQL Local
# Si vous exécutez l'API sur Windows hors du conteneur, utilisez localhost:5433
# Si vous exécutez le backend dans Docker et que la base est exposée sur l'hôte,
# utilisez host.docker.internal:5433 à la place.
DATABASE_URL=postgresql://postgres:admin123@localhost:5433/firdaws_db
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=firdaws_db
